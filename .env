# Cloudflare Web Analytics site token.
# Get it from: Cloudflare dashboard > Analytics & Logs > Web Analytics > Add a site
#   > arunkumaranguraja.com > "Manual setup" > copy the value of "token".
# Leave empty to disable the beacon (no analytics script is emitted).
# This value is public - it is visible in the served HTML - so it is safe to commit.
PUBLIC_CF_BEACON_TOKEN=
